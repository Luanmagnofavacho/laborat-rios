#include <stdio.h>

int main() {
    double celsius;
    double fahrenheit;

    printf("Digite a temperatura em Celsius: ");
    scanf("%lf", &celsius);

    fahrenheit = celsius * 9.0 / 5.0 + 32.0;

    printf("%.2f C = %.2f F\n", celsius, fahrenheit);

    return 0;
}

// Desafio2 //

#include <stdio.h>

int main() {
    const double PI = 3.1415926535;
    double raio;
    double area;

    printf("Digite o raio do circulo: ");
    scanf("%lf", &raio);

    area = PI * raio * raio;

    printf("Area: %.2f\n", area);

    return 0;
}

