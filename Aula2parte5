#include <stdio.h>

int main() {
    double peso;
    double altura;
    double imc;

    printf("Digite seu peso: ");
    scanf("%lf", &peso);

    printf("Digite sua altura: ");
    scanf("%lf", &altura);

    imc = peso / (altura * altura);

    printf("IMC: %.2f\n", imc);

    return 0;
}

