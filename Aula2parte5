#include <stdio.h>

int main() {
    int total;
    int horas;
    int minutos;
    int segundos;
    int resto;

    printf("Digite a quantidade de segundos: ");
    scanf("%d", &total);

    horas = total / 3600;

    resto = total % 3600;

    minutos = resto / 60;

    segundos = resto % 60;

    printf("%d hora(s), %d minuto(s), %d segundo(s)\n",
           horas, minutos, segundos);

    return 0;
}
