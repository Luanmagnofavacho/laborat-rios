#include <stdio.h>

int main(void) {
    int a, b, opcao;

    printf("Digite o primeiro numero: ");
    scanf("%d", &a);

    printf("Digite o segundo numero: ");
    scanf("%d", &b);

    printf("\n--- CALCULADORA ---\n");
    printf("1 - Somar\n");
    printf("2 - Subtrair\n");
    printf("3 - Multiplicar\n");
    printf("4 - Dividir\n");
    printf("5 - Resto da divisao\n");

    printf("Escolha uma opcao: ");
    scanf("%d", &opcao);

    switch (opcao) {
        case 1:
            printf("Resultado: %d\n", a + b);
            break;

        case 2:
            printf("Resultado: %d\n", a - b);
            break;

        case 3:
            printf("Resultado: %d\n", a * b);
            break;

        case 4:
            if (b != 0) {
                printf("Resultado: %.2f\n", (float)a / b);
            } else {
                printf("Divisao por zero nao permitida\n");
            }
            break;

        case 5:
            if (b != 0) {
                printf("Resto: %d\n", a % b);
            } else {
                printf("Nao e possivel calcular o resto com divisor zero\n");
            }
            break;

        default:
            printf("Opcao invalida\n");
    }

    return 0;
}
