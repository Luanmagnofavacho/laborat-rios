#include <stdio.h>

int main() {
    int contador = 0;      // CONTA quantas vezes algo aconteceu
    int acumulador = 0;    // ACUMULA um valor
    int valor;

    for (int i = 0; i < 3; i++) {
        printf("Digite um valor par: ");
        scanf("%d", &valor);
        
        if (valor % 2 == 0) {
            contador++; // mais um par encontrado
            acumulador += valor; // soma o valor
        }
    }

    printf("Quantidade de pares: %d\n", contador);
    printf("Soma dos pares: %d\n", acumulador);
    return 0;
}

