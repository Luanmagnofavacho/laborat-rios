#include <stdio.h>

int main() {
    float nota, soma = 0;
    int quantidade = 0;

    printf("Digite as notas (digite -1 para terminar):\n");

    while (1) {
        printf("Nota: ");
        scanf("%f", &nota);

        if (nota == -1) {
            break;
        }
        soma += nota;       // acumulador
        quantidade++;       // contador
    }

    if (quantidade > 0) {
        float media = soma / quantidade;
        printf("\n--- ESTATISTICAS ---\n");
        printf("Quantidade de notas: %d\n", quantidade);
        printf("Soma total: %.2f\n", soma);
        printf("Media: %.2f\n", media);
    } else {
        printf("Nenhuma nota valida foi digitada.\n");
    }

    return 0;
}
