#include <stdio.h>

int main() {
    int N;
    int soma = 0; // ACUMULADOR

    printf("Digite N: ");
    scanf("%d", &N);

    for (int i = 1; i <= N; i++) {
        soma += i; // acumulador guarda a soma
        // Para anotar: se N=5
        // i=1 -> soma=1
        // i=2 -> soma=3
        // i=3 -> soma=6
        // i=4 -> soma=10
    }

    printf("Soma de 1 ate %d = %d\n", N, soma);
    // Teste N=5 -> 15
    // Teste N=10 -> 55
    return 0;
}

Atividade3

#include <stdio.h>

int main() {
    float nota; // variável de entrada
    float soma = 0; // ACUMULADOR
    int contador = 0; // CONTADOR

    for (int i = 1; i <= 5; i++) {
        printf("Digite a nota %d: ", i);
        scanf("%f", &nota);
        soma += nota;
        contador++;
    }

    float media = soma / contador;

    printf("Soma: %.2f\n", soma);
    printf("Media das 5 notas: %.2f\n", media);
    return 0;
}

