#include <stdio.h>

int main() {
    float nota, soma = 0;
    int quantidade = 0;

    printf("Digite as notas (digite -1 para terminar):\n");

    while (1) {
        printf("Nota: ");
        scanf("%f", &nota);

        if (nota == -1) { // sentinela detectada
            break;
        }

        soma += nota;
        quantidade++;
    }

    if (quantidade > 0) {
        float media = soma / quantidade;
        printf("Media: %.2f\n", media);
    } else {
        printf("Nenhuma nota digitada.\n");
    }

    return 0;
}

