Atividade5

#include <stdio.h>

double somar(double a, double b);
double subtrair(double a, double b);
double multiplicar(double a, double b);
double dividir(double a, double b);
void mostrarMenu(void);
void executarOperacao(int opcao, double a, double b);

int main(void) {
    int opcao;
    double a, b;

    do {
        mostrarMenu();
        scanf("%d", &opcao);

        if (opcao >= 1 && opcao <= 4) {
            printf("Digite dois numeros: ");
            scanf("%lf %lf", &a, &b);
        }

        executarOperacao(opcao, a, b);

    } while (opcao != 0);

    return 0;
}

void mostrarMenu(void) {
    printf("\n========================\n");
    printf("      CALCULADORA\n");
    printf("========================\n");
    printf("1 - Soma\n");
    printf("2 - Subtracao\n");
    printf("3 - Multiplicacao\n");
    printf("4 - Divisao\n");
    printf("0 - Sair\n");
    printf("========================\n");
    printf("Opcao: ");
}

void executarOperacao(int opcao, double a, double b) {
    switch (opcao) {
        case 1:
            printf("Resultado: %.2f\n", somar(a, b));
            break;
        case 2:
            printf("Resultado: %.2f\n", subtrair(a, b));
            break;
        case 3:
            printf("Resultado: %.2f\n", multiplicar(a, b));
            break;
        case 4:
            if (b != 0) {
                printf("Resultado: %.2f\n", dividir(a, b));
            } else {
                printf("Erro: divisao por zero\n");
            }
            break;
        case 0:
            printf("Encerrando...\n");
            break;
        default:
            printf("Opcao invalida\n");
            break;
    }
}

double somar(double a, double b) {
    return a + b;
}

double subtrair(double a, double b) {
    return a - b;
}

double multiplicar(double a, double b) {
    return a * b;
}

double dividir(double a, double b) {
    return a / b;
}
