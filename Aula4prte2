int main() {
    int opcao;

    do {
        printf("\n--- MENU DESAFIO ---\n");
        printf("1 - Mostrar mensagem\n");
        printf("2 - Mostrar seu nome\n");
        printf("0 - Sair\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        switch(opcao) {
            case 1:
                printf("Ola! Voce esta indo bem na disciplina de C!\n");
                break;
            case 2:
                printf("Meu nome e: Seu Nome Aqui\n"); // troque pelo seu nome
                break;
            case 0:
                printf("Encerrando o programa...\n");
                break;
            default:
                printf("Opcao invalida\n");
        }

    } while (opcao != 0);

    return 0;
}
