#include <stdio.h>

int main() {
    int opcao;

    do {
        printf("\n--- MENU ---\n");
        printf("1 - Somar 1 ate N\n");
        printf("2 - Calcular media\n");
        printf("0 - Sair\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        switch(opcao) {
            case 1:
                printf("Voce escolheu a opcao 1\n");
                break;
            case 2:
                printf("Voce escolheu a opcao 2\n");
                break;
            case 0:
                printf("Saindo...\n");
                break;
            default:
                printf("Opcao invalida!\n");
        }

    } while (opcao != 0);
    // O menu aparece ao menos uma vez porque a condicao opcao != 0
    // so e testada DEPOIS do bloco.

    return 0;
}

