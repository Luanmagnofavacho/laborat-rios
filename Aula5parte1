Atividade1 

#include <stdio.h>

void mostrarDobro(int numero) {
    printf("Dobro de %d = %d\n", numero, numero * 2);
}

void mostrarTriplo(int numero) {
    printf("Triplo de %d = %d\n", numero, numero * 3);
}

int main(void) {

    mostrarDobro(10);
    mostrarDobro(7);
    mostrarDobro(5);

    mostrarTriplo(10);
    mostrarTriplo(7);
    mostrarTriplo(5);

    return 0;
}

Atividade2

#include <stdio.h>

void mostrarSoma(int a, int b) {
    printf("%d + %d = %d\n", a, b, a + b);
}

void mostrarProduto(int a, int b) {
    printf("%d * %d = %d\n", a, b, a * b);
}

int main(void) {
    // Na chamada mostrarSoma(5,3), a=5 e b=3 por posição
    mostrarSoma(5, 3);
    mostrarProduto(5, 3);

    mostrarProduto(4, -2); // negativo
    mostrarProduto(0, 10);  // zero

    return 0;
}

