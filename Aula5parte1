#include <stdio.h>

int somar(int a, int b) {
    return a + b; // devolve o resultado, não imprime
}

int main(void) {
    int resultado = somar(10, 5);
    printf("Resultado = %d\n", resultado);
    printf("%d\n", somar(2, 3)); // imprime 5

    return 0;
}

Atividade4

#include <stdio.h>

double calcularMedia(double n1, double n2) {
    double media = (n1 + n2) / 2.0;
    return media;
}

int main(void) {
    printf("Media = %.2f\n", calcularMedia(8.0, 6.0)); // 7.0
    printf("Media = %.2f\n", calcularMedia(8.0, 9.0)); // 8.5 - preserva fração por ser double
    return 0;
}

Atividade5

#include <stdio.h>

double somar(double a, double b) {
    return a + b;
}

double subtrair(double a, double b) {
    return a - b;
}

double multiplicar(double a, double b) {
    return a * b;
}

double dividir(double a, double b) {
    return a / b; // a verificação de zero será feita no main
}

int main(void) {
    double n1, n2;
    printf("Digite dois numeros: ");
    scanf("%lf %lf", &n1, &n2);

    printf("Soma: %.2f\n", somar(n1, n2));
    printf("Subtracao: %.2f\n", subtrair(n1, n2));
    printf("Multiplicacao: %.2f\n", multiplicar(n1, n2));

    if (n2 != 0) {
        printf("Divisao: %.2f\n", dividir(n1, n2));
    } else {
        printf("Divisao: impossivel dividir por zero!\n");
    }

    return 0;
}
