//Atividade2//

#include <stdio.h>
int main() {
    printf("Crescente 1 a 10:\n");
    for (int i = 1; i <= 10; i++) {
        printf("%d ", i);
    }

    printf("\n\nDecrescente 10 a 1:\n");
    for (int i = 10; i >= 1; i--) {
        printf("%d ", i);
    }

    printf("\n\nPasso 2 (pares 0 a 10):\n");
    for (int i = 0; i <= 10; i += 2) {
        printf("%d ", i);
    }

    printf("\n\nDesafio - Impares 1,3,5,...,19:\n");
    for (int i = 1; i <= 19; i += 2) {
        printf("%d ", i);
    }
    return 0;
}

