#include <stdio.h>

int main() {
    for (int tab = 1; tab <= 10; tab++) {
        printf("\n--- Tabuada do %d ---\n", tab);
        for (int i = 1; i <= 10; i++) {
            printf("%d x %d = %d\n", tab, i, tab * i);
        }
    }
