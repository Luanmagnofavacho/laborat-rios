//Atividade4//

#include <stdio.h>

int main() {
    // Somatorio de 1 ate 100
    int soma = 0;
    for (int i = 1; i <= 100; i++) {
        soma += i;
    }
    printf("Soma de 1 ate 100 = %d\n", soma); // resultado 5050

    // Fatorial//
    int n;
    long long fatorial = 1; // começa em 1
    printf("\nDigite n para fatorial: ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        fatorial *= i;
    }

    printf("%d! = %lld\n", n, fatorial);
    return 0;
}

