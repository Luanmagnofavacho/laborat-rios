#include <stdio.h>

int main() {
    int numero, maior, menor;

    printf("Digite o numero 1: ");
    scanf("%d", &maior);
    menor = maior; // inicializa os dois com o primeiro valor

    for (int i = 2; i <= 5; i++) {
        printf("Digite o numero %d: ", i);
        scanf("%d", &numero);

        if (numero > maior) {
            maior = numero;
        }
        if (numero < menor) {
            menor = numero;
        }
    }

    printf("Maior = %d\n", maior);
    printf("Menor = %d\n", menor);
    return 0;
}

