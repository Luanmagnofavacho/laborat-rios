#include <stdio.h>
int main() {
    int numero;
    int positivos = 0;
    int somaPares = 0;

    for (int i = 1; i <= 10; i++) {
        printf("Numero %d: ", i);
        scanf("%d", &numero);
        if (numero > 0) positivos++;
        if (numero % 2 == 0) somaPares += numero;
    }

    printf("Positivos: %d\n", positivos);
    printf("Soma dos pares: %d\n", somaPares);
    return 0;
}

