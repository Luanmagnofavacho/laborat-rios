#include <stdio.h>
int main() {
    printf("Com break:\n");
    for (int i = 1; i <= 100; i++) {
        if (i == 10) {
            break; // para no 9
        }
        printf("%d ", i);
    }

    printf("\n\nCom continue (pula o 5):\n");
    for (int i = 1; i <= 10; i++) {
        if (i == 5) {
            continue; // pula o resto dessa iteração
        }
        printf("%d ", i);
    }
    return 0;
}

