#include <stdio.h>

int main() {
    int senha;
    int tentativas = 0;
    int acesso = 0; // 0 = nao conseguiu, 1 = conseguiu

    while (tentativas < 3) {
        printf("Senha: ");
        scanf("%d", &senha);

        if (senha == 1234) {
            printf("Acesso permitido\n");
            acesso = 1;
            break;
        }

        printf("Senha incorreta\n");
        tentativas++;
    }

    if (acesso == 0) {
        printf("Usuario bloqueado\n");
    }

    return 0;
}
