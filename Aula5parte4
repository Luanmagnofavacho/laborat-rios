#include <stdio.h>
#include <stdbool.h>

bool podeEntrar(int idade, bool bloqueado, bool temIngresso) {
    return idade >= 18 && !bloqueado && temIngresso;
}

int main(void) {
    int idade;
    int bloqueadoInt, ingressoInt;
    
    printf("Idade: ");
    scanf("%d", &idade);
    printf("Bloqueado? (1=sim 0=nao): ");
    scanf("%d", &bloqueadoInt);
    printf("Tem ingresso? (1=sim 0=nao): ");
    scanf("%d", &ingressoInt);

    if (podeEntrar(idade, bloqueadoInt, ingressoInt)) {
        printf("Entrada liberada\n");
    } else {
        printf("Entrada negada\n");
    }
    return 0;
}

