#include <stdio.h>
#include <stdbool.h>

bool ehPar(int numero) {
    return numero % 2 == 0;
}

int main(void) {
    int testes[] = {2, 7, 0, -4};
    for (int i = 0; i < 4; i++) {
        if (ehPar(testes[i])) {
            printf("%d: Par\n", testes[i]);
        } else {
            printf("%d: Impar\n", testes[i]);
        }
    }
    return 0;
}

