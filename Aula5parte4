#include <stdio.h>
#include <stdbool.h>

bool notaValida(double nota) {
    if (nota < 0 || nota > 10) {
        return false;
    }
    return true;
}

int maior(int a, int b) {
    if (a > b) {
        return a;
    }
    return b;
}

int main(void) {
    printf("%d\n", maior(5, 10));
    printf("%d\n", (int)notaValida(11));
    return 0;
}

