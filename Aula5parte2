Atividade4

#include <stdio.h>

int calcularDobro(int numero) {
    return numero * 2;
}

int main(void) {
    int n = 5;
    printf("%d\n", calcularDobro(n)); // explícito de onde vem o valor
    return 0;
}

#include <stdio.h>

int numeroGlobal; // global

int calcularDobro2(void) {
    return numeroGlobal * 2; // depende de estado externo, escondido
}

int main2(void) {
    numeroGlobal = 5;
    printf("%d\n", calcularDobro2());
    return 0;
}

