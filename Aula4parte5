#include <stdio.h>

int main() {
    int opcao;

    do {
        printf("\n=====================\n");
        printf("    MENU PRINCIPAL\n");
        printf("=====================\n");
        printf("1 - Somar dois numeros\n");
        printf("2 - Calcular media\n");
        printf("3 - Tabuada\n");
        printf("0 - Sair\n");
        printf("=====================\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1: {
                float a, b;
                printf("Digite dois numeros: ");
                scanf("%f %f", &a, &b);
                printf("Soma = %.2f\n", a + b);
                break;
            }
            case 2: {
                int qtd;
                float nota, soma = 0;
                printf("Quantidade de notas: ");
                scanf("%d", &qtd);
                for (int i = 1; i <= qtd; i++) {
                    printf("Nota %d: ", i);
                    scanf("%f", &nota);
                    soma += nota;
                }
                if (qtd > 0) printf("Media = %.2f\n", soma / qtd);
                break;
            }
            case 3: {
                int n;
                printf("Qual tabuada? ");
                scanf("%d", &n);
                for (int i = 1; i <= 10; i++) {
                    printf("%d x %d = %d\n", n, i, n * i);
                }
                break;
            }
            case 0:
                printf("Encerrando...\n");
                break;
            default:
                printf("Opcao invalida\n");
        }

    } while (opcao != 0);

    return 0;
}
