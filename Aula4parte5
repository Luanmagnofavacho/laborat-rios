#include <stdio.h>

int main() {
    int quantidade;
    float nota;
    float soma = 0;

    printf("Quantidade de notas: ");
    scanf("%d", &quantidade);

    for (int i = 1; i <= quantidade; i++) {
        printf("Nota %d: ", i);
        scanf("%f", &nota);
        soma += nota; // acumulador
    }

    if (quantidade > 0) {
        printf("Media: %.2f\n", soma / quantidade);
    } else {
        printf("Quantidade invalida.\n");
    }
    return 0;
}

