#include <stdio.h>
#include <stdbool.h>

int main() {
    int dia;
    bool bloqueado;

    printf("Digite o dia da semana (1 a 7): ");
    scanf("%d", &dia);

    if (dia == 6 || dia == 7) {
        printf("Fim de semana\n");
    } else {
        printf("Dia util\n");
    }

    bloqueado = false;

    if (!bloqueado) {
        printf("Acesso permitido\n");
    } else {
        printf("Acesso bloqueado\n");
    }

    return 0;
}

